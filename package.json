{
  "name": "botwarren-ship",
  "version": "0.9.1",
  "private": true,
  "description": "Botwarren ship agent: turns what your AI coding agents are doing into a delayed, metadata-only status feed.",
  "license": "Apache-2.0",
  "homepage": "https://botwarren.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turbokast/botwarren-ship.git"
  },
  "bugs": {
    "email": "support@turbokast.com"
  },
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "botwarren": "./src/cli.ts"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "cli": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "release:build": "node scripts/build-release.mjs",
    "release:sign": "node scripts/release-sign.mjs",
    "release:keygen": "node scripts/release-keygen.mjs",
    "release:templates": "node scripts/render-package-templates.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.12",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.25.12",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  }
}
